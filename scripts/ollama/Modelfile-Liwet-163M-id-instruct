# Liwet-LLM / Liwet-163M-id-instruct (dense, 163M Dense GQA)
# Sumber bobot: https://huggingface.co/fadhilahkhairogi/Liwet-163M-id-instruct
# GGUF dikonversi dengan fork llama.cpp commit cae551692 (branch liwet-moe).
# Bukan untuk diunggah otomatis; jalankan: ollama create <nama> -f <file ini>

FROM E:\liwet_gguf_build\gguf\Liwet-163M-id-instruct-Q8_0.gguf

TEMPLATE """<bos>{{ if .System }}System: {{ .System }}

{{ end }}{{ range .Messages }}{{ if eq .Role "user" }}User: {{ .Content }}

{{ else if eq .Role "assistant" }}Assistant: {{ .Content }}

{{ end }}{{ end }}Assistant:"""

PARAMETER num_ctx 2048
PARAMETER temperature 0.65
PARAMETER top_k 40
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.12
PARAMETER num_predict 192
PARAMETER stop "\n\nUser:"
PARAMETER stop "\n\nSystem:"

SYSTEM """Anda adalah asisten AI berbahasa Indonesia yang membantu, ramah, dan ringkas."""
