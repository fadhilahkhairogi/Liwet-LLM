# Liwet-LLM / Liwet-163M-id-base (dense, 163M Dense GQA)
# Sumber bobot: https://huggingface.co/fadhilahkhairogi/Liwet-163M-id-base
# GGUF dikonversi dengan fork llama.cpp commit cae551692 (branch liwet-moe).
# Bukan untuk diunggah otomatis; jalankan: ollama create <nama> -f <file ini>

FROM E:\liwet_gguf_build\gguf\Liwet-163M-id-base-Q8_0.gguf

TEMPLATE """<bos>{{ .Prompt }}"""

PARAMETER num_ctx 2048
PARAMETER temperature 0.7
PARAMETER top_k 40
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.1
PARAMETER num_predict 128

SYSTEM ""
